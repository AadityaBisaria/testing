# pipecat-bot - Environment Variables
# Copy this file to .env and fill in your API keys


# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID=

# Google Vertex AI (LLM)
# Path to the service-account JSON file. Do not commit that file.
VERTEX_CREDENTIALS_PATH=
VERTEX_LOCATION=asia-south1
VERTEX_PROJECT_ID=
VERTEX_MODEL=gemini-2.5-flash


